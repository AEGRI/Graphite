{
  "training": {
    "batch_size": 4,
    "gradient_accumulation_steps": 8,
    "max_steps": 10000,
    "learning_rate": 0.0003,
    "min_learning_rate": 0.00003,
    "weight_decay": 0.1,
    "gradient_clip_norm": 1.0
  },
  "optimizer": {
    "type": "adamw",
    "betas": [
      0.9,
      0.95
    ],
    "epsilon": 1e-8
  },
  "scheduler": {
    "type": "cosine",
    "warmup_steps": 500
  },
  "precision": {
    "type": "auto"
  },
  "checkpointing": {
    "save_every_steps": 500,
    "keep_last": 3
  },
  "logging": {
    "log_every_steps": 10
  },
  "reproducibility": {
    "seed": 42
  }
}