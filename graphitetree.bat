@echo off
powershell -NoProfile -Command "$exclude = @('.venv','__pycache__'); function Show-Tree($path,$prefix='') { $items = @(Get-ChildItem -LiteralPath $path | Where-Object { $exclude -notcontains $_.Name }); for ($i=0; $i -lt $items.Count; $i++) { $item=$items[$i]; $last=$i -eq $items.Count-1; $branch=if($last){'\-- '}else{'+-- '}; Write-Output ($prefix+$branch+$item.Name); if($item.PSIsContainer) { $next=if($last){$prefix+'    '}else{$prefix+'|   '}; Show-Tree $item.FullName $next } } }; Write-Output (Split-Path -Leaf (Resolve-Path '.')); Show-Tree (Resolve-Path '.').Path"