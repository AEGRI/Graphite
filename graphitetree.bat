@echo off
powershell -NoProfile -Command "$exclude = @('.git','node_modules','target','.venv','__pycache__','.pytest_cache','.mypy_cache','.ruff_cache','.DS_Store','Thumbs.db'); $excludePatterns = @('*.pyc','*.pyo'); function Should-Exclude($item) { if ($exclude -contains $item.Name) { return $true }; foreach ($pattern in $excludePatterns) { if ($item.Name -like $pattern) { return $true } }; return $false }; function Show-Tree($path,$prefix='') { $items = @(Get-ChildItem -LiteralPath $path | Where-Object { -not (Should-Exclude $_) } | Sort-Object @{Expression={$_.PSIsContainer};Descending=$true}, Name); for ($i=0; $i -lt $items.Count; $i++) { $item=$items[$i]; $last=$i -eq $items.Count-1; $branch=if($last){'\-- '}else{'+-- '}; $name=if($item.PSIsContainer){$item.Name + '/'}else{$item.Name}; Write-Output ($prefix+$branch+$name); if($item.PSIsContainer) { $next=if($last){$prefix+'    '}else{$prefix+'|   '}; Show-Tree $item.FullName $next } } }; Write-Output ((Split-Path -Leaf (Resolve-Path '.')) + '/'); Show-Tree (Resolve-Path '.').Path"